// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  BACKOFFICE
}

enum ClientRole {
  OPERATOR
  ADMIN
}
`
enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

model Auth {
  userId     String   @id @default(uuid())
  issuer     String
  subject    String
  email      String?
  username   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([issuer, subject])

  Admin       Admin?
  Technician  Technician?
  CompanyOwned Company[] @relation("CompanyOwner")
  Clients     Client[]
}

model Admin {
  id        String    @id @default(uuid())
  userId    String    @unique
  name      String
  phone     String?
  role      AdminRole

  auth      Auth      @relation(fields: [userId], references: [userId])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Company {
  id        String    @id @default(uuid())
  userId    String
  name      String
  address   String?
  phone     String?

  owner     Auth      @relation("CompanyOwner", fields: [userId], references: [userId])
  clients   Client[]
  invoices  Invoice[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Client {
  id        String     @id @default(uuid())
  companyId String
  userId    String
  name      String
  phone     String?
  role      ClientRole

  company   Company    @relation(fields: [companyId], references: [id])
  auth      Auth       @relation(fields: [userId], references: [userId])
  invoices  Invoice[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([companyId])
  @@index([userId])
}

model Technician {
  id        String    @id @default(uuid())
  userId    String    @unique
  name      String
  phone     String?

  auth      Auth      @relation(fields: [userId], references: [userId])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Invoice {
  id          String        @id @default(uuid())
  companyId   String
  clientId    String?
  code        String        @unique
  amountCents Int
  currency    String        @default("IDR")
  status      InvoiceStatus @default(DRAFT)
  issuedAt    DateTime      @default(now())
  dueAt       DateTime?
  description String?

  company     Company       @relation(fields: [companyId], references: [id])
  client      Client?       @relation(fields: [clientId], references: [id])

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([companyId])
  @@index([clientId])
}
