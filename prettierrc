{
  "printWidth": 80,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "importOrder": [
    "<THIRD_PARTY_MODULES>",
    "^@/(.*)$",
    "^[./]"
  ],
  "tailwindFunctions": [
    "clsx",
    "tw",
    "cva",
    "cn",
    "twMerge"
  ],
  "plugins": [
    "@trivago/prettier-plugin-sort-imports"
  ]
}
